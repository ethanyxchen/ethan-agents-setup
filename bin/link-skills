#!/usr/bin/env bash
set -euo pipefail

skills="$(cd "$(dirname "$0")/../skills" && pwd)"

link_dir() {
  local target="$1"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "skip $target: real directory, move its skills into $skills first" >&2
    return
  fi
  mkdir -p "$(dirname "$target")"
  ln -sfn "$skills" "$target"
}

link_each() {
  local dir="$1"
  mkdir -p "$dir"
  for link in "$dir"/*; do
    if [ -L "$link" ] && [ ! -e "$link" ]; then rm "$link"; fi
  done
  for skill in "$skills"/*/; do
    skill="${skill%/}"
    [ -f "$skill/SKILL.md" ] || continue
    local target="$dir/$(basename "$skill")"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      echo "skip $target: real directory" >&2
      continue
    fi
    ln -sfn "$skill" "$target"
  done
}

link_dir "$HOME/.claude/skills"
link_dir "$HOME/.agents/skills"
link_each "$HOME/.codex/skills"
